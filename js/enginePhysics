function updateEnginePhysics(){


    let throttle = gas ? 1 : 0;


    let currentGear = gearbox.gear;



    /*
    ==============================
    Moteur au neutre
    ==============================
    */


    if(currentGear === 0){


        if(throttle){


            rpm += 250;


        }

        else{


            rpm -= 150;


        }


    }



    /*
    ==============================
    Moteur en prise
    ==============================
    */


    else{


        let ratio = getGearRatio();


        let torque = getEngineTorque(rpm);



        let load =

        speed *

        ratio *

        0.2;



        let acceleration =

        (torque - load);



        rpm += acceleration;

    }




    /*
    ==============================
    Limites
    ==============================
    */


    if(rpm < 1200)

        rpm = 1200;



    if(rpm > 14000)

        rpm = 14000;


}






function getEngineTorque(rpm){


    if(rpm < 3000)

        return 70;



    if(rpm < 8000)

        return 112;



    if(rpm < 12000)

        return 100;



    return 80;


}
